# Adjust these for the display server used by the appliance image.
# These values assume an X11 session, which is what this deployment has been
# written and reviewed against. A Wayland session, which is the default on
# current Raspberry Pi OS, needs different variables and is untested. See
# deploy/README.md before deploying there.
DISPLAY=:0
KIVY_NO_ARGS=1

# Input hardware, chosen once for the console, as Pi Scan 1.5 chose it when the
# card was written. "mouse" suits a mouse or trackball on any HDMI screen;
# "touch" adds the mtdev provider the official Raspberry Pi touchscreen needs.
# The two are alternatives, not a combination.
PI_SCAN_INPUT=mouse
